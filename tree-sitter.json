{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "rust",
      "camelcase": "Rust",
      "scope": "source.rust",
      "path": ".",
      "file-types": ["rs"],
      "highlights": ["queries/highlights.scm"],
      "injections": ["queries/injections.scm"],
      "tags": ["queries/tags.scm"],
      "injection-regex": "rust"
    }
  ],
  "metadata": {
    "version": "0.24.2",
    "license": "MIT",
    "description": "Rust grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-rust"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
